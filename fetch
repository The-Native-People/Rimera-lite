#!/usr/bin/env bash
set -euo pipefail

# Usage:
#   ./fetchdsl.sh 'fetch > https://www.api.com/api > JSON()'

expr="${*:-}"

if [[ -z "$expr" ]]; then
  echo "usage: $0 'fetch > https://example.com/api > JSON()'" >&2
  exit 2
fi

# Parse:
#   fetch > URL > JSON()
if [[ "$expr" =~ ^[[:space:]]*fetch[[:space:]]*\>[[:space:]]*([^[:space:]]+)[[:space:]]*\>[[:space:]]*JSON\(\)[[:space:]]*$ ]]; then
  url="${BASH_REMATCH[1]}"
else
  echo "Invalid syntax." >&2
  echo "Expected: fetch > URL > JSON()" >&2
  exit 2
fi

# Add https:// if no scheme was supplied.
if [[ ! "$url" =~ ^https?:// ]]; then
  url="https://$url"
fi

# Fetch and pretty-print/validate JSON.
curl -fsSL "$url" | python3 -m json.tool
